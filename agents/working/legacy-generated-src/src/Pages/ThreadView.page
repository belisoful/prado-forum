<%@ Page Language="PHP" Title="Thread" %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%=$this->Title%></title>
</head>
<body class="forum-page forum-page--thread">

<header class="forum-header">
  <div class="forum-header__inner">
    <h1 class="forum-header__title">
      <a href="<%=$this->getForumManager()->createUrl('forum/ForumHome')%>">
        <%=htmlspecialchars($this->getForumManager()->getSiteName())%>
      </a>
    </h1>
    <com:TForumSearch ID="HeaderSearch" ModuleID="forum" />
  </div>
</header>

<main class="forum-main">
  <div class="forum-layout">
    <div class="forum-layout__primary">

      <com:TForumBreadcrumbs ID="Breadcrumbs" ModuleID="forum" />

      <% if ($this->getThread()): %>
      <div class="forum-thread-header">
        <h2 class="forum-thread-header__title"><%=htmlspecialchars($this->getThread()->title)%></h2>
        <div class="forum-thread-header__meta">
          <% if ($this->getThread()->is_locked): %>
          <span class="forum-badge forum-badge--locked">🔒 Locked</span>
          <% endif; %>
          <% if ($this->getThread()->is_pinned || $this->getThread()->is_sticky): %>
          <span class="forum-badge forum-badge--pinned">📌 Pinned</span>
          <% endif; %>
          <span class="forum-thread-stats">
            <%=(int)$this->getThread()->view_count%> views &middot;
            <%=(int)$this->getThread()->reply_count%> replies
          </span>
        </div>
      </div>

      <com:TForumPoll    ID="Poll"     ModuleID="forum"
        ThreadId="<%=(int)$this->getRequest()->getParam('id',0)%>" />

      <com:TForumPostList ID="PostList" ModuleID="forum"
        ThreadId="<%=(int)$this->getRequest()->getParam('id',0)%>"
        Page="<%=$this->getCurrentPage()%>" />

      <com:TForumReply   ID="Reply"   ModuleID="forum"
        ThreadId="<%=(int)$this->getRequest()->getParam('id',0)%>" />

      <% else: %>
      <p class="forum-error">Thread not found.</p>
      <% endif; %>

    </div>
    <aside class="forum-layout__sidebar">
      <com:TForumStats    ID="Stats"      ModuleID="forum" />
      <com:TForumRecentPosts ID="RecentPosts" ModuleID="forum" Limit="5" />
    </aside>
  </div>
</main>

<footer class="forum-footer">
  <p>&copy; <%=date('Y')%> <%=htmlspecialchars($this->getForumManager()->getSiteName())%></p>
</footer>
</body>
</html>
