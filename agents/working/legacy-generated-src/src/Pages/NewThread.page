<%@ Page Language="PHP" Title="New Thread" %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%=$this->Title%></title>
</head>
<body class="forum-page forum-page--new-thread">

<header class="forum-header">
  <div class="forum-header__inner">
    <h1 class="forum-header__title">
      <a href="<%=$this->getForumManager()->createUrl('forum/ForumHome')%>">
        <%=htmlspecialchars($this->getForumManager()->getSiteName())%>
      </a>
    </h1>
  </div>
</header>

<main class="forum-main">
  <div class="forum-layout forum-layout--full">

    <com:TForumBreadcrumbs ID="Breadcrumbs" ModuleID="forum" />

    <% if ($this->getBoard()): %>
    <h2 class="forum-page-title">Post New Thread in: <%=htmlspecialchars($this->getBoard()->name)%></h2>

    <com:TForumNewThread ID="NewThreadForm" ModuleID="forum"
      BoardId="<%=$this->getBoardId()%>" />

    <% else: %>
    <p class="forum-error">No board selected. Please go back and choose a board.</p>
    <% endif; %>

  </div>
</main>

<footer class="forum-footer">
  <p>&copy; <%=date('Y')%> <%=htmlspecialchars($this->getForumManager()->getSiteName())%></p>
</footer>
</body>
</html>
